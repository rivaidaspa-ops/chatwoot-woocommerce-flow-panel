NODE_ENV=production
PORT=3001
PUBLIC_BASE_URL=https://app.rivaida.cl
ALLOWED_ORIGINS=

PANEL_USER=admin
PANEL_PASSWORD=admin123
PANEL_APP_TOKEN=panel_seguro_2026

DATABASE_URL=postgres://paneluser:TU_PASSWORD@chatriva-ai_panel-postgres:5432/paneldb?sslmode=disable
REDIS_URL=redis://default:TU_PASSWORD@chatriva-ai_panel-redis:6379

DEFAULT_STORE=cl
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
PAGE_CACHE_SECONDS=120
PRODUCT_INDEX_ENABLED=true
PRODUCT_PAGE_SIZE=20
MAX_PAGE_SIZE=40
SYNC_PER_PAGE=50
VARIATION_CACHE_SECONDS=3600
CHATWOOT_SEND_IMAGE_ATTACHMENT=true

# Desde v7.7 las credenciales de WooCommerce, Chatwoot y Flow se pueden guardar desde el menu Credenciales del panel.
# Deja estas vacias si las vas a cargar desde la interfaz:
WC_URL=
WC_KEY=
WC_SECRET=
CO_WC_URL=
CO_WC_KEY=
CO_WC_SECRET=
CHATWOOT_URL=
CHATWOOT_API_KEY=
CHATWOOT_ACCOUNT_ID=1
PAYMENT_LINK_PROVIDER=woocommerce
