NODE_ENV=production
PORT=3001

PUBLIC_BASE_URL=https://app.rivaida.cl
ALLOWED_ORIGINS=https://app.rivaida.cl,https://www.chatriva.com,https://chatriva.com,https://www.rivaida.cl,https://rivaida.cl

PANEL_USER=admin
PANEL_PASSWORD=admin123
PANEL_APP_TOKEN=panel_seguro_2026

DATABASE_URL=postgres://paneluser:TU_PASSWORD@chatriva-ai_panel-postgres:5432/paneldb?sslmode=disable
REDIS_URL=redis://default:TU_PASSWORD@chatriva-ai_panel-redis:6379

CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
PAGE_CACHE_SECONDS=120
PRODUCT_INDEX_ENABLED=true
PRODUCT_PAGE_SIZE=20
MAX_PAGE_SIZE=40
SYNC_PER_PAGE=50
VARIATION_CACHE_SECONDS=3600

DEFAULT_STORE=cl
MULTISTORE_ENABLED=true

WC_URL=https://www.rivaida.cl
WC_KEY=ck_chile
WC_SECRET=cs_chile
WOO_FLOW_GATEWAY_ID=flow
WOO_FLOW_GATEWAY_TITLE=Flow

CO_WC_URL=https://colombia.tu-dominio.com
CO_WC_KEY=ck_colombia
CO_WC_SECRET=cs_colombia
CO_STORE_NAME=Rivaida Colombia
CO_CURRENCY=COP
CO_DOCUMENT_LABEL=CC / NIT
CO_REQUIRE_DOCUMENT=true
CO_DEFAULT_POSTCODE=110111
CO_WOO_PAYMENT_GATEWAY_ID=cod
CO_WOO_PAYMENT_GATEWAY_TITLE=Pago Woo Colombia / Dropi

PAYMENT_LINK_PROVIDER=woocommerce

CHATWOOT_URL=https://www.chatriva.com
CHATWOOT_API_KEY=tu_token_chatwoot
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_STORE_MAP={"12":"cl","15":"co"}

REQUIRE_RUT=true
DEFAULT_POSTCODE=8320000
CHILE_STATE_FORMAT=name
AI_RECOMMENDATION_WEBHOOK_URL=

# Enviar imagen real como adjunto a Chatwoot/WhatsApp al enviar producto
CHATWOOT_SEND_IMAGE_ATTACHMENT=true
IMAGE_FETCH_TIMEOUT_MS=15000
IMAGE_MAX_BYTES=8000000
