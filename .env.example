NODE_ENV=production
PORT=3001
PUBLIC_BASE_URL=https://panel.tudominio.cl

PANEL_USER=admin
PANEL_PASSWORD=cambia_esta_clave
PANEL_APP_TOKEN=cambia_este_token_largo_para_chatwoot

DATABASE_URL=postgres://paneluser:Rivaida1012@chatriva-ai_panel-postgres:5432/paneldb?sslmode=disable
REDIS_URL=redis://default:Rivaida1012@chatriva-ai_panel-redis:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
PAGE_CACHE_SECONDS=120
PRODUCT_INDEX_ENABLED=true
PRODUCT_PAGE_SIZE=20
MAX_PAGE_SIZE=40
SYNC_PER_PAGE=50
VARIATION_CACHE_SECONDS=3600

WC_URL=https://tutienda.cl
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxx
WC_TIMEOUT_MS=30000

FLOW_API_URL=https://www.flow.cl/api
FLOW_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
FLOW_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
FLOW_PAYMENT_METHOD=9
FLOW_URL_CONFIRMATION=https://panel.tudominio.cl/flow/confirmacion
