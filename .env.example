NODE_ENV=production
PORT=3001
PUBLIC_BASE_URL=https://panel.tudominio.cl
ALLOWED_ORIGINS=https://panel.tudominio.cl,https://www.chatriva.com

PANEL_USER=admin
PANEL_PASSWORD=CAMBIA_ESTA_CLAVE
PANEL_APP_TOKEN=CAMBIA_TOKEN_LARGO_PARA_CHATWOOT_APP

DATABASE_URL=postgres://paneluser:password@chatriva-ai_panel-postgres:5432/paneldb?sslmode=disable
REDIS_URL=redis://default:password@chatriva-ai_panel-redis:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
PAGE_CACHE_SECONDS=120
PRODUCT_INDEX_ENABLED=true
PRODUCT_PAGE_SIZE=20
MAX_PAGE_SIZE=40
SYNC_PER_PAGE=50
VARIATION_CACHE_SECONDS=3600

WC_URL=https://www.rivaida.cl
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxx
WOO_FLOW_GATEWAY_ID=flow
WOO_FLOW_GATEWAY_TITLE=Flow - Webpay / Multicaja
PAYMENT_LINK_PROVIDER=woocommerce

FLOW_API_URL=https://www.flow.cl/api
FLOW_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
FLOW_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
FLOW_PAYMENT_METHOD=9
FLOW_URL_CONFIRMATION=https://panel.tudominio.cl/flow/confirmacion
FLOW_URL_RETURN=https://panel.tudominio.cl/flow/retorno

CHATWOOT_URL=https://www.chatriva.com
CHATWOOT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxx
CHATWOOT_ACCOUNT_ID=1

REQUIRE_RUT=true
DEFAULT_POSTCODE=8320000
CHILE_STATE_FORMAT=name
AI_RECOMMENDATION_WEBHOOK_URL=
