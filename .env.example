# Servidor
PORT=3000
PUBLIC_BASE_URL=https://panel.tudominio.cl
ALLOWED_ORIGINS=https://panel.tudominio.cl,https://chatwoot.tudominio.cl

# Login visual + HTTP Basic Auth
PANEL_USER=admin
PANEL_PASSWORD=cambia_esta_password_larga

# WooCommerce REST API v3
WC_URL=https://tutienda.cl
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flow Chile
# Produccion: https://www.flow.cl/api
# Sandbox: https://sandbox.flow.cl/api
FLOW_API_URL=https://sandbox.flow.cl/api
FLOW_API_KEY=tu_api_key_flow
FLOW_SECRET_KEY=tu_secret_key_flow
FLOW_COMMERCE_EMAIL=pagos@tutienda.cl
FLOW_PAYMENT_METHOD=9
FLOW_CURRENCY=CLP
FLOW_URL_CONFIRMATION=https://panel.tudominio.cl/flow/confirmacion
FLOW_URL_RETURN=https://panel.tudominio.cl/flow/retorno

# Chatwoot Application API
CHATWOOT_URL=https://chatwoot.tudominio.cl
CHATWOOT_API_KEY=tu_api_key_chatwoot
CHATWOOT_ACCOUNT_ID=1
